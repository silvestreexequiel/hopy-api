# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# The .env file is NEVER versioned (see .gitignore).
# It uses the SAME variable names as escuelahopi/env.php.
# The API connects to the same MySQL as the academy-operations portal.

# --- MySQL database (shared with the PHP portal) ---
ACADEMY_DB_HOST=localhost
ACADEMY_DB_NAME=
ACADEMY_DB_USER=
ACADEMY_DB_PASS=
ACADEMY_DB_CHARSET=utf8mb4

# --- Staff login (POST /api/v1/auth/login) ---
ACADEMY_STAFF_USER=
ACADEMY_STAFF_PASS=

# --- Basic auth for the destructive reset (DELETE /api/v1/cleanup/reset) ---
ACADEMY_ADMIN_USER=
ACADEMY_ADMIN_PASS=

# --- OpenAI (POST /api/v1/chat) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Mobile portal session signing key ---
HOPI_JWT_SECRET=hopi-mobile-2025
