# Copie a .env y complete. Reusa los MISMOS nombres que escuelahopi/env.php.
# La API se conecta al mismo MySQL que el portal academy-operations.

# --- Base de datos MySQL (compartida con el PHP) ---
ACADEMY_DB_HOST=localhost
ACADEMY_DB_NAME=
ACADEMY_DB_USER=
ACADEMY_DB_PASS=
ACADEMY_DB_CHARSET=utf8mb4

# --- Login staff (POST /api/v1/auth/login) ---
ACADEMY_STAFF_USER=
ACADEMY_STAFF_PASS=

# --- Basic auth del reset destructivo (DELETE /api/v1/cleanup/reset) ---
ACADEMY_ADMIN_USER=
ACADEMY_ADMIN_PASS=

# --- OpenAI (POST /api/v1/chat) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Firma de sesion del portal mobile ---
HOPI_JWT_SECRET=hopi-mobile-2025
